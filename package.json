{
  "name": "arreglos-victoria-floreria",
  "version": "1.0.0",
  "description": "Florería familiar con más de 20 años de experiencia en Recoleta. Flores naturales, arreglos florales para ocasiones especiales, bodas, eventos y decoración.",
  "main": "frontend/assets/js/main.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "build": "vite build",
    "build:components": "node scripts/build-components.js",
    "preview": "vite preview",
    "test": "jest",
    "lint": "eslint dev/assets/js/**/*.js dev/components/**/*.js --config config/.eslintrc.json",
    "lint:fix": "eslint dev/assets/js/**/*.js dev/components/**/*.js --config config/.eslintrc.json --fix",
    "start:frontend": "node start-frontend.js",
    "start:backend": "node backend/server.js",
    "start:both": "node start-servers.js",
    "start:microservices": "node start-microservices.js",
    "fix:images": "node scripts/fix-images.js",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "preview:vite": "vite preview --port 3006",
    "verify:pages": "node scripts/verify-html-pages.js",
    "fix:duplicates": "node scripts/fix-duplicate-imports.js",
    "fix:all": "node scripts/fix-all-issues.js",
    "optimize:images": "node scripts/optimize-images.js",
    "dev:both": "concurrently \"npm run start:backend\" \"npm run dev:vite\"",
    "dev:microservices": "concurrently \"npm run start:microservices\" \"npm run dev:vite\""
  },
  "keywords": [
    "floreria",
    "arreglos-florales",
    "ecommerce",
    "nodejs",
    "javascript"
  ],
  "author": "Arreglos Victoria",
  "license": "MIT",
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mime-types": "^3.0.1",
    "nodemailer": "^6.9.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "babel-jest": "^30.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^8.46.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.6.2",
    "jest-environment-jsdom": "^30.1.2",
    "nodemon": "^3.0.1",
    "vite": "^4.4.9"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/usuario/floreria-arreglos-victoria.git"
  },
  "bugs": {
    "url": "https://github.com/usuario/floreria-arreglos-victoria/issues"
  },
  "homepage": "https://github.com/usuario/floreria-arreglos-victoria#readme"
}
