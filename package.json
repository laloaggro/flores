{
  "name": "arreglos-victoria",
  "version": "1.0.0",
  "description": "Tienda online de arreglos florales",
  "main": "build-simple.js",
  "scripts": {
    "build": "node build-simple.js",
    "build:css": "node build-simple.js --css",
    "build:js": "node build-simple.js --js",
    "dev": "nodemon backend/server.js",
    "start": "node backend/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest frontend/assets/js/*.test.js",
    "test:integration": "jest frontend/integration/*.test.js",
    "test:e2e": "cypress run",
    "test:watch": "jest --watch",
    "lint:css": "stylelint frontend/assets/css/**/*.css"
  },
  "keywords": [
    "ecommerce",
    "flowers",
    "tienda",
    "online"
  ],
  "author": "Mauricio Garay",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "cypress": "^13.0.0",
    "jest": "^29.0.0",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0"
  }
}
